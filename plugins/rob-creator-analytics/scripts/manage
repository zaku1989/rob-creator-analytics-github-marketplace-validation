#!/bin/sh
set -eu

if [ -z "${PLUGIN_ROOT:-}" ] || [ -z "${PLUGIN_DATA:-}" ]; then
  echo "Plugin startup failed: the host must supply PLUGIN_ROOT and PLUGIN_DATA" >&2
  exit 1
fi

platform=$(uname -s)
architecture=$(uname -m)

if [ "$platform" != "Darwin" ] || [ "$architecture" != "arm64" ]; then
  echo "Unsupported management helper target" >&2
  exit 1
fi

bootstrap="$PLUGIN_ROOT/scripts/runtime-bootstrap"
entrypoint="$PLUGIN_ROOT/runtime/management-helper.mjs"

if [ ! -d "$PLUGIN_DATA" ] || [ ! -w "$PLUGIN_DATA" ] ||
   [ ! -x "$bootstrap" ] || [ ! -f "$entrypoint" ]; then
  echo "Plugin management runtime is unavailable: verify host runtime roots and reinstall the package if assets are missing" >&2
  exit 1
fi

node_path=$("$bootstrap")
exec "$node_path" "$entrypoint" "$@"
