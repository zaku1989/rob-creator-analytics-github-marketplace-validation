#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -P -- "$(/usr/bin/dirname -- "$0")" && pwd)
. "$script_dir/local-paths"
if ! resolve_local_paths "$0"; then
  echo "Plugin runtime is unavailable: verify native user data permissions and reinstall the package" >&2
  exit 1
fi

platform=$(uname -s)
architecture=$(uname -m)

if [ "$platform" != "Darwin" ] || [ "$architecture" != "arm64" ]; then
  echo "Unsupported runtime target: $platform/$architecture" >&2
  exit 1
fi

bootstrap="$PLUGIN_ROOT/scripts/runtime-bootstrap"
server_path="$PLUGIN_ROOT/runtime/shared-analytics-mcp.mjs"

if [ ! -d "$PLUGIN_DATA" ] || [ ! -w "$PLUGIN_DATA" ] ||
   [ ! -x "$bootstrap" ] || [ ! -f "$server_path" ]; then
  echo "Plugin runtime is unavailable: verify native user data permissions and reinstall the package if assets are missing" >&2
  exit 1
fi

node_path=$("$bootstrap")
exec "$node_path" "$server_path"
